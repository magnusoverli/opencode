#!/usr/bin/env bash
# =============================================================================
# ha-context - Inspect and refresh the context OpenCode is given about this
#              Home Assistant installation
#
# Everything OpenCode is told about your setup before you type anything is
# visible here. Nothing is hidden: these are plain files you can read, and the
# ones you own you can edit or delete.
# =============================================================================

set -euo pipefail

BRIEFING="/data/context/home-briefing.md"
DIGEST="/data/context/decision-notes.md"
NOTES="/homeassistant/opencode/decisions.yaml"
LOCAL_INSTRUCTIONS="/homeassistant/AGENTS.local.md"
GENERATOR="/usr/local/bin/generate-home-context.mjs"

usage() {
    cat <<'EOF'
Usage: ha-context <command> [options]

Inspect the context OpenCode receives about this Home Assistant installation.

Commands:
  status       What is enabled, where it lives, and how much context it costs
  show         Print every context file OpenCode is given (default)
  briefing     Print the generated install briefing only
  notes        Print your decision notes file only
  refresh      Regenerate the briefing and the decision-notes digest now
  reset        Delete the generated files (rebuilt on refresh or restart)

Options:
  --notes      With 'reset': also delete your decision notes. Requires --yes.
  --yes        Skip the confirmation prompt for destructive actions.

Examples:
  ha-context status
  ha-context show
  ha-context refresh
  ha-context reset
EOF
}

human_bytes() {
    local bytes="$1"
    if [ "${bytes}" -lt 1024 ]; then
        printf '%s B' "${bytes}"
    else
        printf '%s KB' "$((bytes / 1024))"
    fi
}

# Rough but honest: ~4 bytes per token for English prose.
approx_tokens() {
    printf '~%s tokens' "$(( $1 / 4 ))"
}

file_line() {
    local label="$1" path="$2" owner="$3"
    if [ -f "${path}" ]; then
        local bytes
        bytes=$(wc -c < "${path}" | tr -d ' ')
        printf '  %-22s %s\n' "${label}" "${path}"
        printf '  %-22s present, %s (%s), %s\n' "" "$(human_bytes "${bytes}")" "$(approx_tokens "${bytes}")" "${owner}"
    else
        printf '  %-22s %s\n' "${label}" "${path}"
        printf '  %-22s not present, %s\n' "" "${owner}"
    fi
}

print_file() {
    local title="$1" path="$2"
    if [ ! -f "${path}" ]; then
        return 0
    fi
    echo "===== ${title} — ${path} ====="
    echo ""
    cat "${path}"
    echo ""
}

cmd_status() {
    echo "OpenCode home context"
    echo ""
    echo "Sent to the model with every request:"
    file_line "Install briefing" "${BRIEFING}" "generated by the add-on"
    file_line "Decision notes digest" "${DIGEST}" "generated from your notes"
    file_line "Your instructions" "${LOCAL_INSTRUCTIONS}" "yours — create it to add your own rules"
    echo ""
    echo "Read on request only:"
    file_line "Decision notes" "${NOTES}" "yours — written only when you approve"
    echo ""
    echo "Add-on options:"
    printf '  %-22s %s\n' "Install briefing" "${OPENCODE_HOME_BRIEFING:-unknown}"
    printf '  %-22s %s\n' "Decision notes" "${OPENCODE_DECISION_NOTES:-unknown}"
    echo ""
    echo "Turn either off in the add-on Configuration tab. Delete AGENTS.local.md to"
    echo "stop loading your own instructions."
}

cmd_show() {
    local shown=0
    for entry in "Install briefing:${BRIEFING}" "Decision notes digest:${DIGEST}" "Your instructions:${LOCAL_INSTRUCTIONS}"; do
        local title="${entry%%:*}"
        local path="${entry#*:}"
        if [ -f "${path}" ]; then
            print_file "${title}" "${path}"
            shown=1
        fi
    done
    if [ "${shown}" -eq 0 ]; then
        echo "No context files yet. Run 'ha-context refresh' or restart the add-on."
    fi
}

cmd_refresh() {
    if [ ! -f "${GENERATOR}" ]; then
        echo "Error: ${GENERATOR} is missing." >&2
        exit 1
    fi
    echo "Regenerating home context..."
    # One pass only: an interactive refresh should not sit and retry for minutes
    # if Home Assistant happens to be down.
    HOME_CONTEXT_SINGLE_PASS=true \
    OPENCODE_HOME_BRIEFING="${OPENCODE_HOME_BRIEFING:-true}" \
    OPENCODE_DECISION_NOTES="${OPENCODE_DECISION_NOTES:-true}" \
        node "${GENERATOR}"
    echo ""
    echo "Done. New sessions pick this up automatically; restart an open session to use it now."
}

cmd_reset() {
    local include_notes="$1" assume_yes="$2"

    rm -f "${BRIEFING}" "${DIGEST}"
    echo "Removed the generated context files."

    if [ "${include_notes}" = "true" ]; then
        if [ "${assume_yes}" != "true" ]; then
            echo "Refusing to delete ${NOTES} without --yes." >&2
            exit 1
        fi
        if [ -f "${NOTES}" ]; then
            rm -f "${NOTES}"
            echo "Deleted your decision notes at ${NOTES}."
        else
            echo "No decision notes to delete."
        fi
    fi

    echo "Run 'ha-context refresh' or restart the add-on to rebuild."
}

COMMAND="${1:-show}"
shift || true

INCLUDE_NOTES=false
ASSUME_YES=false
for arg in "$@"; do
    case "${arg}" in
        --notes) INCLUDE_NOTES=true ;;
        --yes|-y) ASSUME_YES=true ;;
        *)
            echo "Unknown option: ${arg}" >&2
            usage >&2
            exit 1
            ;;
    esac
done

case "${COMMAND}" in
    status)   cmd_status ;;
    show)     cmd_show ;;
    briefing) print_file "Install briefing" "${BRIEFING}" ;;
    notes)    print_file "Decision notes" "${NOTES}" ;;
    refresh)  cmd_refresh ;;
    reset)    cmd_reset "${INCLUDE_NOTES}" "${ASSUME_YES}" ;;
    -h|--help|help) usage ;;
    *)
        echo "Unknown command: ${COMMAND}" >&2
        usage >&2
        exit 1
        ;;
esac

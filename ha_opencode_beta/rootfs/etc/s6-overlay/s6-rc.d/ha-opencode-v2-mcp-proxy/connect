#!/command/with-contenv bash

V2_RUNTIME_ROOT="${V2_RUNTIME_ROOT:-/run/opencode-v2}"
SIDECAR_READY_FILE="${V2_RUNTIME_ROOT}/mcp-sidecar.ready"
SIDECAR_SOCKET="${V2_RUNTIME_ROOT}/mcp-sidecar.sock"

# The root listener binds immediately so there is no replacement window.
# Validate both root-owned paths and the worker's exact process identity
# so startup and stale readiness after an abrupt exit both return cleanly.
backend_ready() {
    [ -f "${SIDECAR_READY_FILE}" ] \
        && [ ! -L "${SIDECAR_READY_FILE}" ] \
        && [ "$(stat -c '%u:%g:%a:%h' "${SIDECAR_READY_FILE}" 2>/dev/null || true)" = "0:0:600:1" ] \
        && [ -S "${SIDECAR_SOCKET}" ] \
        && [ ! -L "${SIDECAR_SOCKET}" ] \
        && [ "$(stat -c '%u:%g:%a:%h' "${SIDECAR_SOCKET}" 2>/dev/null || true)" = "0:0:600:1" ] \
        || return 1

    read -r ready_pid ready_start extra < "${SIDECAR_READY_FILE}" || return 1
    case "${ready_pid}" in ''|*[!0-9]*) return 1 ;; esac
    case "${ready_start}" in ''|*[!0-9]*) return 1 ;; esac
    [ -z "${extra:-}" ] || return 1
    process_stat=$(cat "/proc/${ready_pid}/stat" 2>/dev/null) || return 1
    # Everything after the final command-name parenthesis starts at field 3;
    # process start time is field 22, or positional field 20 in this suffix.
    set -f
    set -- ${process_stat##*) }
    [ "${1:-}" != "Z" ] || return 1
    [ "${20:-}" = "${ready_start}" ] || return 1
    [ "$(awk '/^Uid:/ {print $2":"$3":"$4}' "/proc/${ready_pid}/status" 2>/dev/null)" = "0:0:0" ]
}

if ! backend_ready; then
    printf 'HTTP/1.1 503 Service Unavailable\r\nConnection: close\r\nContent-Length: 0\r\n\r\n'
    exit 0
fi

# A failure after validated readiness is genuine and remains visible in the log.
exec s6-ipcclient "${SIDECAR_SOCKET}" s6-ioconnect

#!/usr/bin/env bash
# =============================================================================
# ha-context - Inspect and refresh the context OpenCode is given about this
#              Home Assistant installation
#
# Everything OpenCode is told about your setup before you type anything is
# visible here. Nothing is hidden: these are plain files you can read, and the
# ones you own you can edit or delete.
# =============================================================================

set -euo pipefail

# Which channel this add-on is, and therefore which notes file is ours. The
# stable and beta add-ons share the configuration directory but not their
# notes.
# shellcheck source=/usr/local/lib/opencode/channel.sh
source /usr/local/lib/opencode/channel.sh

BRIEFING="/data/context/home-briefing.md"
DIGEST="/data/context/decision-notes.md"
NOTES="${ADDON_STATE_DIR}/decisions.yaml"
# Both of these are shared with the other channel by design: AGENTS.local.md is
# the user's own file and the add-on never writes it, and AGENTS.md is found by
# OpenCode through the working directory, so a per-channel name would simply be
# ignored.
LOCAL_INSTRUCTIONS="/homeassistant/AGENTS.local.md"
BASE_INSTRUCTIONS="${ADDON_AGENTS_FILE}"
GENERATOR="/usr/local/bin/generate-home-context.mjs"

# Pick up the add-on options as they were actually configured. Without this the
# defaults below would report a feature as enabled when the user turned it off,
# and 'refresh' would regenerate context for it.
if [ -f /data/.env_vars ]; then
    # shellcheck disable=SC1091
    . /data/.env_vars
fi

usage() {
    cat <<'EOF'
Usage: ha-context <command> [options]

Inspect the context OpenCode receives about this Home Assistant installation.

Commands:
  status       What is enabled, where it lives, and how much context it costs
  show         Print every context file OpenCode is given (default)
  briefing     Print the generated install briefing only
  notes        Print your decision notes file only
  refresh      Regenerate the briefing and the decision-notes digest now
  reset        Delete the generated files (rebuilt on refresh or restart)

Options:
  --notes      With 'reset': also delete your decision notes. Requires --yes.
  --yes        Skip the confirmation prompt for destructive actions.

Examples:
  ha-context status
  ha-context show
  ha-context refresh
  ha-context reset
EOF
}

human_bytes() {
    local bytes="$1"
    if [ "${bytes}" -lt 1024 ]; then
        printf '%s B' "${bytes}"
    else
        printf '%s KB' "$((bytes / 1024))"
    fi
}

# Rough but honest: ~4 bytes per token for English prose.
approx_tokens() {
    printf '~%s tokens' "$(( $1 / 4 ))"
}

file_line() {
    local label="$1" path="$2" owner="$3"
    if [ -f "${path}" ]; then
        local bytes
        bytes=$(wc -c < "${path}" | tr -d ' ')
        printf '  %-22s %s\n' "${label}" "${path}"
        printf '  %-22s present, %s (%s), %s\n' "" "$(human_bytes "${bytes}")" "$(approx_tokens "${bytes}")" "${owner}"
    else
        printf '  %-22s %s\n' "${label}" "${path}"
        printf '  %-22s not present, %s\n' "" "${owner}"
    fi
}

# What each file is allowed to contain, and who wrote it. Printed above the
# contents so a line in the output can always be traced back to its source
# without guessing.
provenance() {
    case "$1" in
        base)
            echo "Shipped with the add-on: the safety rules, Home Assistant YAML guidance, and"
            echo "tool instructions OpenCode follows. Refreshed on add-on update unless you have"
            echo "edited it. This is the largest of the four files - put your own rules in"
            echo "AGENTS.local.md instead, which updates never touch."
            ;;
        briefing)
            echo "Written by the add-on, rebuilt at every start. Describes the shape of your"
            echo "installation: HA version and hardware, configuration layout, area and floor"
            echo "names, how many entities exist per domain, integrations, custom components."
            echo "It does NOT contain individual entity names or states, your coordinates, or"
            echo "anything from secrets.yaml. Editing it has no effect - it is regenerated."
            ;;
        digest)
            echo "Generated from the notes you approved, in ${NOTES}."
            echo "One line per active note - pinned first, then newest - carrying its date, title,"
            echo "decision, and any entity, file or integration you attached to it. That is why an"
            echo "entity name can appear here without being in the briefing. It also says how many"
            echo "notes it is showing of the total. Rationale and retired notes stay in the file"
            echo "and are read only when OpenCode asks for them."
            ;;
        local)
            echo "Yours. Written only by you; the add-on loads it as-is and never edits it."
            echo "Anything in here reaches the model exactly as you wrote it."
            ;;
    esac
}

print_file() {
    local title="$1" path="$2" kind="${3:-}"
    if [ ! -f "${path}" ]; then
        return 0
    fi
    echo "===== ${title} — ${path} ====="
    if [ -n "${kind}" ]; then
        provenance "${kind}"
    fi
    echo ""
    cat "${path}"
    echo ""
}

cmd_status() {
    echo "OpenCode home context"
    echo ""
    echo "Sent to the model with every request:"
    file_line "Add-on instructions" "${BASE_INSTRUCTIONS}" "the add-on's own rules, refreshed on update"
    file_line "Install briefing" "${BRIEFING}" "generated by the add-on"
    file_line "Decision notes digest" "${DIGEST}" "generated from your notes"
    file_line "Your instructions" "${LOCAL_INSTRUCTIONS}" "yours — create it to add your own rules"
    echo ""
    echo "Read on request only:"
    file_line "Decision notes" "${NOTES}" "yours — written only when you approve"
    echo ""
    echo "Add-on options:"
    printf '  %-22s %s\n' "Install briefing" "${OPENCODE_HOME_BRIEFING:-unknown}"
    printf '  %-22s %s\n' "Decision notes" "${OPENCODE_DECISION_NOTES:-unknown}"
    echo ""
    echo "Turn either off in the add-on Configuration tab. Delete AGENTS.local.md to"
    echo "stop loading your own instructions."
}

cmd_show() {
    local shown=0
    for entry in "Add-on instructions|${BASE_INSTRUCTIONS}|base" \
                 "Install briefing|${BRIEFING}|briefing" \
                 "Decision notes digest|${DIGEST}|digest" \
                 "Your instructions|${LOCAL_INSTRUCTIONS}|local"; do
        local title="${entry%%|*}"
        local rest="${entry#*|}"
        local path="${rest%%|*}"
        local kind="${rest#*|}"
        if [ -f "${path}" ]; then
            print_file "${title}" "${path}" "${kind}"
            shown=1
        fi
    done
    if [ "${shown}" -eq 0 ]; then
        echo "No context files yet. Run 'ha-context refresh' or restart the add-on."
    fi
}

cmd_refresh() {
    if [ ! -f "${GENERATOR}" ]; then
        echo "Error: ${GENERATOR} is missing." >&2
        exit 1
    fi
    # Say plainly when a feature is off: without this, 'refresh' removes that
    # feature's file and still reports success, which reads as a failed rebuild.
    if [ "${OPENCODE_HOME_BRIEFING:-true}" != "true" ]; then
        echo "Install briefing is turned off — its file will be removed, not regenerated."
    fi
    if [ "${OPENCODE_DECISION_NOTES:-true}" != "true" ]; then
        echo "Decision notes are turned off — the digest will be removed, not regenerated."
    fi

    echo "Regenerating home context..."
    # One pass only: an interactive refresh should not sit and retry for minutes
    # if Home Assistant happens to be down.
    HOME_CONTEXT_SINGLE_PASS=true \
    OPENCODE_HOME_BRIEFING="${OPENCODE_HOME_BRIEFING:-true}" \
    OPENCODE_DECISION_NOTES="${OPENCODE_DECISION_NOTES:-true}" \
        node "${GENERATOR}"
    echo ""
    echo "Regeneration finished — the lines above say what was rebuilt and what was left alone."
    echo "New sessions pick this up automatically; restart an open session to use it now."
}

cmd_reset() {
    local include_notes="$1" assume_yes="$2"

    # Refuse before touching anything: deleting the generated files and *then*
    # aborting leaves the user worse off than if they had not run the command.
    if [ "${include_notes}" = "true" ] && [ "${assume_yes}" != "true" ]; then
        echo "Refusing to delete ${NOTES} without --yes. Nothing was changed." >&2
        exit 1
    fi

    rm -f "${BRIEFING}" "${DIGEST}"
    echo "Removed the generated context files."

    if [ "${include_notes}" = "true" ]; then
        if [ -f "${NOTES}" ]; then
            rm -f "${NOTES}"
            echo "Deleted your decision notes at ${NOTES}."
        else
            echo "No decision notes to delete."
        fi
    fi

    echo "Run 'ha-context refresh' or restart the add-on to rebuild."
}

COMMAND="${1:-show}"
shift || true

INCLUDE_NOTES=false
ASSUME_YES=false
for arg in "$@"; do
    case "${arg}" in
        --notes) INCLUDE_NOTES=true ;;
        --yes|-y) ASSUME_YES=true ;;
        *)
            echo "Unknown option: ${arg}" >&2
            usage >&2
            exit 1
            ;;
    esac
done

case "${COMMAND}" in
    status)   cmd_status ;;
    show)     cmd_show ;;
    briefing)
        if [ -f "${BRIEFING}" ]; then
            print_file "Install briefing" "${BRIEFING}" "briefing"
        else
            echo "No install briefing at ${BRIEFING}."
            echo "It is written at add-on start; run 'ha-context refresh' to build one now,"
            echo "or check whether the Install briefing option is turned off."
        fi
        ;;
    notes)
        if [ -f "${NOTES}" ]; then
            print_file "Decision notes" "${NOTES}"
        else
            echo "No decision notes at ${NOTES}."
            echo "The file appears the first time you approve a note OpenCode proposes."
        fi
        ;;
    refresh)  cmd_refresh ;;
    reset)    cmd_reset "${INCLUDE_NOTES}" "${ASSUME_YES}" ;;
    -h|--help|help) usage ;;
    *)
        echo "Unknown command: ${COMMAND}" >&2
        usage >&2
        exit 1
        ;;
esac

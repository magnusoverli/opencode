#!/usr/bin/env bash

set -u

# shellcheck source=/usr/local/lib/opencode/channel.sh
source /usr/local/lib/opencode/channel.sh

BLUE='\033[38;2;29;153;243m'
GREEN='\033[38;2;17;209;22m'
YELLOW='\033[38;2;246;116;0m'
CYAN='\033[38;2;26;188;156m'
GRAY='\033[38;2;127;140;141m'
BOLD='\033[1m'
NC='\033[0m'

ADDON_VERSION=$(cat /data/.addon_version 2>/dev/null || echo "unknown")
V2_VERSION=$(cat /usr/local/share/opencode-v2-certified-version 2>/dev/null || echo "unknown")
V1_VERSION=$(cat /usr/local/share/opencode-certified-version 2>/dev/null || echo "unknown")

clear
echo ""
echo -e "${BLUE}${BOLD}${ADDON_CHANNEL_LABEL}${NC} ${GRAY}v${ADDON_VERSION}${NC}"
echo -e "${GRAY}Current TUI: OpenCode V2 ${V2_VERSION}${NC}"
echo -e "${GRAY}Rollback runtime retained: OpenCode V1 ${V1_VERSION}${NC}"
echo -e "${GRAY}AI-powered coding agent for Home Assistant${NC}"
echo ""
echo -e "${GRAY}────────────────────────────────────────────────────────────${NC}"
echo ""
echo -e "${GREEN}V2 terminal security boundary${NC}"
echo -e "${GRAY}The TUI runs as uid 60001; the V2 server runs as root for HAOS compatibility.${NC}"
echo -e "${GRAY}Home Assistant configuration is mounted at ${CYAN}/homeassistant${NC}."
echo -e "${GRAY}Set ${YELLOW}Terminal runtime${GRAY} to ${YELLOW}V1 rollback${GRAY} and restart only if V2 cannot start.${NC}"
echo ""

if [ ! -x /usr/local/bin/opencode-v2-tui-launch ]; then
    echo -e "${YELLOW}V2 TUI launcher is unavailable. Select V1 rollback in the add-on configuration.${NC}" >&2
    exit 126
fi

exec /usr/local/bin/opencode-v2-tui-launch /run/opencode-v2
